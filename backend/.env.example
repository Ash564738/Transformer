# Render backend variables. Set these in Render -> Environment.
DGA_AUTH_SECRET=generate-a-long-random-secret
DGA_ADMIN_EMAIL=admin@example.com
DGA_ADMIN_PASSWORD=CHANGE_ME
DGA_ADMIN_NAME=Administrator
DGA_SESSION_HOURS=24

DGA_FAST_MODE=1
DGA_MAX_ROWS=2200
DGA_MAX_ROWS_PER_TRANSFORMER=12
DGA_PREDICTION_WAIT_SECONDS=105
DGA_SAVE_DATABASE=1
DGA_PERSIST_OUTPUTS=0
DGA_WRITE_CLEAN_ARTIFACTS=0
DGA_MAX_UPLOAD_MB=10
DGA_PREDICTION_CACHE_TTL=600
DGA_CORS_ORIGINS=*

DGA_MODEL_CACHE=0
DGA_RANKING_DIAGNOSTICS=0
DGA_SLOW_STAGE_SECONDS=8

OPENROUTER_API_KEY=REPLACE_WITH_A_NEW_KEY
DGA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
DGA_CHAT_FALLBACK_MODELS=openai/gpt-oss-20b:free,openrouter/free
DGA_CHAT_TIMEOUT=8
DGA_CHAT_MAX_TOKENS=700
DGA_CHAT_SQL_TIMEOUT=3
DGA_CHAT_SQL_RETRIES=1
DGA_CHAT_MAX_ROWS=200
DGA_CHAT_MAX_RESULT_CHARS=18000

PORT=10000

# Vercel frontend
NEXT_PUBLIC_BACKEND_URL=https://transformer-kgen.onrender.com