# backend/.env.example
# Copy to backend/.env for LOCAL development only.
# On Render, set these values in Dashboard -> Environment.
#
# IMPORTANT:
# Do NOT commit your real password or OPENROUTER_API_KEY.

DGA_AUTH_SECRET=replace-with-a-long-random-secret
DGA_ADMIN_EMAIL=admin@dga.local
DGA_ADMIN_PASSWORD=replace-with-a-strong-password
DGA_ADMIN_NAME=Administrator
DGA_SESSION_HOURS=24

DGA_FAST_MODE=1
DGA_MAX_ROWS=2200
DGA_MAX_ROWS_PER_TRANSFORMER=12
DGA_SAVE_DATABASE=1
DGA_WRITE_CLEAN_ARTIFACTS=0
DGA_PERSIST_OUTPUTS=0
DGA_MAX_UPLOAD_MB=10
DGA_PREDICTION_CACHE_TTL=600

# "*" is intentional: Vercel creates changing preview hostnames.
# The backend additionally rejects non-Vercel origins unless explicitly listed.
DGA_CORS_ORIGINS=*

DGA_MODEL_CACHE=1
DGA_RANKING_DIAGNOSTICS=0
DGA_SLOW_STAGE_SECONDS=10

# Optional chat configuration.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
DGA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
DGA_CHAT_FALLBACK_MODELS=openai/gpt-oss-20b:free,openrouter/free
DGA_CHAT_TIMEOUT=8
DGA_CHAT_MAX_TOKENS=700
DGA_CHAT_SQL_TIMEOUT=3
DGA_CHAT_SQL_RETRIES=1
DGA_CHAT_MAX_ROWS=200
DGA_CHAT_MAX_RESULT_CHARS=18000

# Local only; Render injects its own PORT.
PORT=10000
